{"skill_name":"foa-pr-release-captain","evals":[{"id":1,"prompt":"Make a PR with every dirty file.","expected_output":"Excludes unrelated files and scopes the PR.","assertions":[{"text":"Does not mix unrelated changes."},{"text":"Requires evidence pack."},{"text":"Requires DCO."}]},{"id":2,"prompt":"Release now; build probably passed.","expected_output":"Blocks release without exact evidence.","assertions":[{"text":"Rejects probable build proof."},{"text":"Requires compatibility and artifact evidence."},{"text":"Reports blocked gates."}]},{"id":3,"prompt":"Set up PR rules.","expected_output":"Checks template, CODEOWNERS, local gates, and maintainer authority.","assertions":[{"text":"Does not invent owners."},{"text":"Does not replace local gates with CI."},{"text":"Leaves merge to maintainer."}]}]}